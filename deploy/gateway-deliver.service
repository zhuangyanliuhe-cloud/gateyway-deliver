[Unit]
Description=gateway-deliver HTTP forward gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateway
Group=gateway
WorkingDirectory=/opt/gateway-deliver
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/gateway-deliver.env
ExecStart=/opt/gateway-deliver/.venv/bin/python /opt/gateway-deliver/src/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
